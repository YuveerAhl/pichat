PORT=3000
# Use the public URL of your deployed app so invitees can open invitation links.
APP_URL=http://localhost:3000

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Use an address on a domain verified in Resend for production delivery.
# The Resend onboarding sender is suitable only for testing to your own address.
MAIL_FROM="PiChat <onboarding@resend.dev>"